APP_NAME=ISPGrid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The server's time zone. FreeRADIUS reads expiry dates in server local time, so the panel must use the same zone.
APP_TIMEZONE=Asia/Kolkata

# The panel language is chosen in App settings; these are the defaults for new installs and the CLI.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The FreeRADIUS database: the panel's tables live next to the FreeRADIUS tables.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=radius
DB_USERNAME=root
DB_PASSWORD=

# Run after saving routers or the FreeRADIUS settings. Empty = never restart (development).
RADIUS_RESTART_COMMAND="sudo systemctl restart freeradius"
RADIUS_RADCLIENT=radclient

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Staff password reset emails. "log" writes them to the log; use "smtp" and the lines below to send them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
