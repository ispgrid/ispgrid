includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Read the casts from each model's casts() body: its @return array<string, string> hides them otherwise.
    parseModelCastsMethod: true

    ignoreErrors:
        # Only the page components in resources/views use these traits, and those are not analysed (their
        # #[Computed] properties and anonymous classes need a Livewire-aware setup).
        -
            identifier: trait.unused
            paths:
                - app/Livewire/Concerns/AuthorizesEveryRequest.php
                - app/Livewire/Concerns/ConfirmsPasswordAgain.php
                - app/Livewire/Concerns/RestartsFreeRadius.php
                - app/Livewire/Concerns/ManagesInvoices.php
                - app/Livewire/Concerns/PricesRecharges.php
                - app/Livewire/Concerns/ShowsToasts.php
                - app/Livewire/Concerns/TakesPayment.php
                - app/Livewire/Concerns/WritesInvoices.php
