#!/usr/bin/env bash
#
#  ISPGrid backup: the radius database, the add-on databases (ispgrid_*, e.g. the session records archive), and the
#  config that belongs to them (FreeRADIUS, the panel's .env with its APP_KEY, the add-on list, the WireGuard keys, the
#  L2TP/IPsec key and logins), in /var/backups/ispgrid, kept 14 days. Prints the radius dump's path last.
#  Copy /var/backups/ispgrid to another machine: a backup on the same disk does not survive the disk.
#
#  Restore, on a server installed with the same ISPGrid version:
#    1. systemctl stop freeradius ispgrid-queue
#       runuser -u ispgrid -- php /opt/ispgrid/artisan down
#    2. gunzip < /var/backups/ispgrid/radius-YYYYMMDD-HHMM.sql.gz | mysql radius
#       and each add-on dump, e.g.: mysql -e 'CREATE DATABASE IF NOT EXISTS ispgrid_ipdr'
#       gunzip < /var/backups/ispgrid/ispgrid_ipdr-YYYYMMDD-HHMM.sql.gz | mysql ispgrid_ipdr
#    3. tar -xzf /var/backups/ispgrid/config-YYYYMMDD-HHMM.tgz -C /
#    4. sudo /opt/ispgrid/deploy/install.sh --yes
#       The dump holds no MariaDB users: the installer sets their passwords to the restored ones (.env and the
#       FreeRADIUS sql module), restarts the services (and the tunnels) and brings the panel back up.
#
set -euo pipefail
dir=/var/backups/ispgrid
keep_days=14
stamp=$(date +%Y%m%d-%H%M)
umask 077
install -d -m 700 "$dir"

mysqldump --single-transaction --routines --triggers radius | gzip > "$dir/radius-$stamp.sql.gz.part"
mv "$dir/radius-$stamp.sql.gz.part" "$dir/radius-$stamp.sql.gz"

#  Add-on databases (e.g. ispgrid_ipdr, the session records archive) next to radius.
mapfile -t addon_dbs < <(mysql -N -e "SHOW DATABASES LIKE 'ispgrid\\_%'")
for db in "${addon_dbs[@]}"; do
  mysqldump --single-transaction --routines --triggers "$db" | gzip > "$dir/$db-$stamp.sql.gz.part"
  mv "$dir/$db-$stamp.sql.gz.part" "$dir/$db-$stamp.sql.gz"
done

paths=(etc/freeradius)
[[ -f /opt/ispgrid/.env ]] && paths+=(opt/ispgrid/.env)
[[ -f /opt/ispgrid/addons.json ]] && paths+=(opt/ispgrid/addons.json)
[[ -d /etc/wireguard ]] && paths+=(etc/wireguard)
[[ -f /etc/swanctl/conf.d/ispgrid-l2tp-secret.conf ]] && paths+=(etc/swanctl/conf.d/ispgrid-l2tp-secret.conf etc/ppp/chap-secrets)
tar -czf "$dir/config-$stamp.tgz" -C / "${paths[@]}"

find "$dir" -maxdepth 1 -type f \( -name '*.sql.gz' -o -name 'config-*.tgz' \) -mtime +"$((keep_days - 1))" -delete
echo "$dir/radius-$stamp.sql.gz"
